{
  "primitives": {
    "color": {
      "neutral": {
        "0": { "$type": "color", "$value": "#ffffff" },
        "50": { "$type": "color", "$value": "#f8fafc" },
        "100": { "$type": "color", "$value": "#f1f5f9" },
        "200": { "$type": "color", "$value": "#e2e8f0" },
        "300": { "$type": "color", "$value": "#cbd5e1" },
        "500": { "$type": "color", "$value": "#64748b" },
        "700": { "$type": "color", "$value": "#334155" },
        "900": { "$type": "color", "$value": "#0f172a" },
        "950": { "$type": "color", "$value": "#020617" }
      },
      "accent": {
        "500": { "$type": "color", "$value": "#2563eb" },
        "600": { "$type": "color", "$value": "#1d4ed8" },
        "400": { "$type": "color", "$value": "#3b82f6" }
      },
      "danger": {
        "500": { "$type": "color", "$value": "#dc2626" }
      }
    },
    "space": {
      "2": { "$type": "dimension", "$value": "0.125rem" },
      "4": { "$type": "dimension", "$value": "0.25rem" },
      "6": { "$type": "dimension", "$value": "0.375rem" },
      "8": { "$type": "dimension", "$value": "0.5rem" },
      "10": { "$type": "dimension", "$value": "0.625rem" },
      "12": { "$type": "dimension", "$value": "0.75rem" },
      "16": { "$type": "dimension", "$value": "1rem" },
      "20": { "$type": "dimension", "$value": "1.25rem" },
      "24": { "$type": "dimension", "$value": "1.5rem" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "0.25rem" },
      "md": { "$type": "dimension", "$value": "0.5rem" },
      "lg": { "$type": "dimension", "$value": "0.75rem" }
    },
    "font": {
      "size": {
        "sm": { "$type": "dimension", "$value": "0.875rem" },
        "md": { "$type": "dimension", "$value": "1rem" },
        "lg": { "$type": "dimension", "$value": "1.125rem" }
      },
      "weight": {
        "medium": { "$type": "number", "$value": "500" },
        "semibold": { "$type": "number", "$value": "600" }
      }
    },
    "shadow": {
      "sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgb(2 6 23 / 0.12)" },
      "md": { "$type": "shadow", "$value": "0 8px 24px -12px rgb(2 6 23 / 0.35)" }
    }
  }
}
