{
  "name": "@praxis/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Praxis minimal UI components using semantic design tokens",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "pnpm --filter @praxis/design-tokens build && storybook dev -p 6006",
    "storybook:build": "pnpm --filter @praxis/design-tokens build && CI=1 storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@praxis/design-tokens": "workspace:*",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.6.3",
    "vite": "^6.2.0"
  }
}
