{
  "name": "@praxis/planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run -w @praxis/design-tokens build && next dev",
    "build": "npm run -w @praxis/design-tokens build && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e/smoke.capture-today-complete-review.spec.ts",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.capture-today-complete-review.spec.ts",
    "test:a11y": "playwright test tests/a11y/inbox-today.a11y.spec.ts",
    "test:e2e:axe": "playwright test tests/a11y/inbox-today.a11y.spec.ts",
    "test:e2e:keyboard": "playwright test tests/a11y/inbox-today.a11y.spec.ts --grep \"keyboard focus\""
  },
  "dependencies": {
    "@praxis/design-tokens": "0.1.0",
    "@praxis/ui": "0.1.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
