---
import "@/styles/global.css";

interface Props {
  title?: string;
}

const { title = "Project Praxis" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="header">
        <div class="brand">
          <small>Project Praxis</small>
          <strong>Calm Execution System</strong>
        </div>
        <nav class="nav" aria-label="Site links">
          <a href="/">Home</a>
          <a href="/docs">Docs</a>
          <a href="/planner">Planner</a>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
