{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-praxis.local/schemas/stitch-inventory.schema.json",
  "title": "StitchInventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "projects", "canonical_policy", "canonical_slots", "totals"],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "source_command": { "type": "string" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "project_title", "total_screens", "canonical_coverage", "duplicate_count", "unmapped_count"],
        "properties": {
          "project_id": { "type": "string" },
          "project_title": { "type": "string" },
          "total_screens": { "type": "integer", "minimum": 0 },
          "canonical_coverage": { "type": "string" },
          "duplicate_count": { "type": "integer", "minimum": 0 },
          "unmapped_count": { "type": "integer", "minimum": 0 },
          "slot_coverage": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "canonical_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "representative_rule", "project_priority"],
      "properties": {
        "strategy": { "type": "string" },
        "representative_rule": { "type": "string" },
        "project_priority": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project_id", "project_title"],
            "properties": {
              "project_id": { "type": "string" },
              "project_title": { "type": "string" }
            }
          }
        }
      }
    },
    "canonical_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_code",
          "slot_label",
          "canonical_screens",
          "representative_screen_id",
          "representative_project_id",
          "representative_height",
          "representative_selection"
        ],
        "properties": {
          "slot_code": { "type": "string" },
          "slot_label": { "type": "string" },
          "representative_screen_id": { "type": "string" },
          "representative_project_id": { "type": "string" },
          "representative_height": { "type": "integer", "minimum": 0 },
          "representative_selection": { "type": "string" },
          "canonical_screens": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["project_id", "project_title", "screen_id", "title", "width", "height"],
              "properties": {
                "project_id": { "type": "string" },
                "project_title": { "type": "string" },
                "screen_id": { "type": "string" },
                "title": { "type": "string" },
                "width": { "type": "integer", "minimum": 0 },
                "height": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_count", "screen_count"],
      "properties": {
        "project_count": { "type": "integer", "minimum": 0 },
        "screen_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
